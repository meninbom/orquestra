{
  "name": "agentboard",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-pdf-assets.mjs && tsc -b && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "build:shared": "node scripts/build-shared.mjs",
    "desktop": "npm run build && npm run build:shared && node scripts/start-desktop.mjs",
    "dist:win": "npm run build && npm run build:shared && electron-builder --win nsis --x64",
    "test": "npm run build:shared && node scripts/build-test-modules.mjs && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "description": "Whiteboard com projetos, seções e apresentações animadas",
  "author": "Orquestra",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.orquestra.whiteboard",
    "productName": "Orquestra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/orquestra.html",
      "dist/pdfjs/**/*",
      "desktop/**/*.cjs",
      "desktop/icon.ico",
      "public/fonts/*OFL.txt",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Orquestra-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orquestra",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    }
  }
}
